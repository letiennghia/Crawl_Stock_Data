        {
            "block_label": "text",
            "block_content": "Với phương châm hành động \"Kỷ cương - Hiệu quả - Chuyến đổi hoạt động\", năm 2023, HDQT đánh giá toàn hệ thống BIDV đã nổ lực triển khai và quyết tầm năng cao năng lực hoạt động, tập trung các biện pháp mở rộng quy mô hoạt động gần với kiểm soát chất lượng tin dụng, cải thiện cơ cấu tài sản hợp lý, biết giảm chi phí, tinh giản quy trình, năng cao năng suất lao động và đầy mạnh chất lượng phục vụ khách hàng, gia tăng năng lực cạnh tranh trên thị trường, cụ thể.",
            "block_bbox": [
                427,
                619,
                1063,
                774
            ],
            "block_id": 6,
            "block_order": 3,
            "group_id": 6,
            "global_block_id": 1387,
            "global_group_id": 1387,
            "block_polygon_points": [
                [
                    427.0,
