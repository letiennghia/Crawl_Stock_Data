        {
            "block_label": "text",
            "block_content": "Liên quan tới vấn đề xử lý ngữ xấu, hiện nay Nghị quyết số 42/2017/QH14 (Nghị quyết số 42) về thi điểm xử lý ngữ xấu của các TCTD đã hết hiệu lực vào ngày 31/12/2023 trong khi đó Bộ Luật dân sự năm 2015. Nghị định số 21/2021/NĐ-CP ngày 19/3/2021 quy định thi hành Bộ Luật dân sự về bảo đảm thực hiện nghĩa vụ không còn quy định cơ chế thu giữ tài sản bảo đảm để xử lý.",
            "block_bbox": [
                102,
                1025,
                577,
                1181
            ],
            "block_id": 6,
            "block_order": 4,
            "group_id": 6,
            "global_block_id": 758,
            "global_group_id": 758,
            "block_polygon_points": [
