    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Trong năm 2016, UBQLRR đặt ra năm rùi ro trọng yếu cần ưu tiên là (i) nợ xấu, (ii) chương trình quản lý kinh doanh liên tục, (iii) quản trị dữ liệu, (iv) tuân thủ quy định pháp luật và (v) nâng cao hiệu quả công tác kiểm toán nội bộ (KTNB). Một số hành động cụ thể đã thực hiện như sau:",
            "block_bbox": [
                135,
                158,
                856,
                269
            ],
            "block_id": 0,
            "block_order": 1,
