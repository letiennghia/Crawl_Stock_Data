            ]
        },
        {
            "block_label": "text",
            "block_content": "Giá hàng hóa cơ bản đã rồi xa mức đấy thiết lập vào Quý I/2016 và phục hồi với tốc độ khá nhanh, nhất là vào những tháng cuối năm (giá đầu mô cuối năm 2016 tăng 37,4% và giá lương thực tăng 11,7% so với đầu năm) song tính bình quân cả năm thì mức giá vẫn còn thấp hơn năm 2015. (Giá đầu WTI ước giảm 12,1%; giá hàng hóa phi năng lượng giảm 4,1%, theo WB.)",
            "block_bbox": [
                134,
                747,
                858,
                917
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "global_block_id": 296,
