                [
                    136.0,
                    615.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Tăng trưởng thương mại toàn cầu giảm mạnh từ 3,9% năm 2014 và 2,6% năm 2015 xuống còn 2,3% năm 2016 mà nguyên nhân chính là kinh tế phục hồi chậm, tổng cầu giảm sút, và cung hàng hóa cơ bản, nhất là dầu mỏ, vượt quá nhu cầu tiêu thụ.",
            "block_bbox": [
                136,
                632,
                859,
                731
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "global_block_id": 295,
            "global_group_id": 295,
            "block_polygon_points": [
