        {
            "block_label": "text",
            "block_content": "Năm 2016 là năm cuối cùng của ACB trong giai đoạn hoàn thiện nền tăng, xây dựng năng lực tiến tới vị trí ngân hàng hàng đầu Việt Nam. Trong năm 2016, ACB tiếp tục khác phục, xử lý các vấn đề tồn động, đồng thời bắt đầu những cuộc bút phá trong hoạt động kinh doanh.",
            "block_bbox": [
                150,
                253,
                860,
                389
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "global_block_id": 332,
            "global_group_id": 332,
            "block_polygon_points": [
                [
                    150.0,
                    253.0
                ],
                [
                    860.0,
                    253.0
                ],
                [
                    860.0,
                    389.0
                ],
                [
                    150.0,
                    389.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Lợi nhuận trước thuế của toàn Tập đoàn trong năm 2016 đạt 1.667 tỷ đồng, tăng 27% so với năm 2015 và vượt 11% kế hoạch cả năm đã đề ra. Về phía doanh thu, trong năm 2016, thu nhập lãi thuần của ACB tăng 17%, biên sinh lời được cải thiện ở mức 3.17%, tăng 8 điểm so với năm 2015. Thu nhập ngoài lãi cũng có bước tăng trưởng ấn tượng 32%, chiếm 20% trên tổng thu nhập. Trong đó, thu dịch vụ tăng mạnh 27% theo đúng định hướng đã đề ra nhờ tăng cường tập trung chú trọng vào mảng khách hàng cá nhân và dịch vụ tài chính, đồng thời từng bước giúp giám bót rùi ro phụ thuộc quá nhiều vào tín dụng. Chi phí trong năm 2016 mặc dù phải phân bổ ngân sách cho hai nhiệm vụ quan trọng là nâng cấp hạ tầng công nghệ thông tin và tiếp tục kế hoạch chuyển đổi hệ thống nhận diện thương hiệu mới, tuy nhiên vẫn luôn được kiểm soát chặt chẽ. Chi phí thực tế thấp hơn so với kế hoạch, với tốc độ tăng 16%.",
            "block_bbox": [
                150,
                404,
                860,
                822
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "global_block_id": 333,
            "global_group_id": 333,
            "block_polygon_points": [
                [
                    150.0,
