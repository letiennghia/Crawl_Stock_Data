    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Về chất lượng phục vụ khách hàng, ACB đã xây dựng Bộ chuẩn mực dịch vụ khách hàng và tiến hành các hoạt động đo lường, đánh giá chất lượng dịch vụ của ACB, làm cơ sở cho việc triển khai mạnh mẽ các hoạt động cải tiến, nâng cao chất lượng dịch vụ khách hàng từ năm 2015.",
