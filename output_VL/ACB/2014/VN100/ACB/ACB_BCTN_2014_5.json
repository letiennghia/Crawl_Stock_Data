                [
                    140.0,
                    609.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Tính ưu việt liên tục trong hoạt động thể hiện ở việc ứng dụng kịp thời các tiến bộ công nghệ, các phương thức quản trị điều hành tiến tiến; quan trọng hơn, nó còn nằm ở khả năng phát triển ACB dựa trên thế mạnh cạnh tranh là con người, là chủ thể sử dụng những yếu tố vật chất. ACB phải là nơi tập hợp những con người tiến bộ, ham học tập, thích đổi mới, có tham vọng xây dựng ACB là ngân hàng hàng đầu.",
            "block_bbox": [
