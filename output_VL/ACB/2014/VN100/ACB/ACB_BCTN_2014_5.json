    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "- Tháng 3/2015, The Asian Banker, một tổ chức có uy tín hoạt động trong lĩnh vực truyền thông tài chính ngân hàng, trên cơ sở thành tụ của ACB năm 2014, đã bình chọn ACB là ngân hàng bán lẻ tiến bộ nhất khu vực Châu Á-Thái Bình Dương.",
            "block_bbox": [
                139,
                111,
                858,
                222
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "global_block_id": 29,
            "global_group_id": 29,
            "block_polygon_points": [
                [
                    139.0,
