                [
                    139.0,
                    222.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Năm 2015 và những năm tiếp theo, ACB cần tiếp tục gìn giữ ba điều quan trọng: sự hài lòng lâu dài của khách hàng, niềm tin bền vững của cổ đông, và tính ưu việt liên tục trong hoạt động.",
            "block_bbox": [
                139,
                230,
                858,
                316
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "global_block_id": 30,
            "global_group_id": 30,
            "block_polygon_points": [
                [
                    139.0,
                    230.0
                ],
                [
                    858.0,
                    230.0
                ],
                [
                    858.0,
                    316.0
                ],
                [
                    139.0,
                    316.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Sự hài lòng lâu dài của khách hàng không chỉ năm ở sản phẩm dịch vụ đáp ứng nhu cầu mà còn ở chất lượng phục vụ, cùng với các kênh giao dịch tiện lợi cho hoạt động kinh doanh và cuộc sống của khách hàng. ACB cần đi xa hơn việc cạnh tranh bằng giá phí để giữ khách hàng; phải hiểu khách hàng hơn; do đó cần đầu tư cho năng lực nắm bắt nhu cầu của khách hàng và phát triển mới quan hệ cùng có lợi một cách nghiêm túc.",
            "block_bbox": [
                140,
                325,
                859,
                493
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "global_block_id": 31,
            "global_group_id": 31,
            "block_polygon_points": [
                [
                    140.0,
                    325.0
                ],
                [
                    859.0,
                    325.0
                ],
                [
                    859.0,
                    493.0
                ],
                [
                    140.0,
                    493.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Niềm tin bền vững của cổ đông được quyết định bởi kết quả hoạt động kinh doanh tốt, trong sự giảm sát của cổ đông và các bên hữu quan khác. ACB thực hiện nguyên tắc minh bạch, kiên trì mục tiêu phát triển bền vững để có hiệu quả bền vững.",
            "block_bbox": [
                140,
                495,
                859,
                609
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "global_block_id": 32,
            "global_group_id": 32,
            "block_polygon_points": [
                [
                    140.0,
