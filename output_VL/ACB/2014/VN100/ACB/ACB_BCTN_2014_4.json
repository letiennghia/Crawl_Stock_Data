        },
        {
            "block_label": "text",
            "block_content": "Về chiến lược, ACB đã cơ bản hoàn thiện các nền tảng, tạo tiền đề để chuyển sang giai đoạn tiếp theo 2015-2016 là tăng cường xây dựng năng lực cạnh tranh bền vững, hướng đến khả năng vị thế ngân hàng hàng đầu Việt Nam.",
            "block_bbox": [
                138,
                536,
                853,
                622
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "global_block_id": 23,
