        {
            "block_label": "text",
            "block_content": "Năm 2014 đánh dấu năm thứ hai ACB thực hiện ý đồ chiến lược giai đoạn 2013-2018, và cũng là năm thứ hai ACB thực hiện lộ trình tái cơ cấu giai đoạn 2013-2015 để giải quyết những vấn đề tồn đọng.",
            "block_bbox": [
                137,
                441,
                852,
                527
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
