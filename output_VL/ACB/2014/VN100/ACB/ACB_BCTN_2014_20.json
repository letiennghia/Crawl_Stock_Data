        {
            "block_label": "paragraph_title",
            "block_content": "2.3.2.1 Tóm tắt tình hình hoạt động và tình hình tài chính của Công ty Chứng khoán ACB (ACB Securities)",
            "block_bbox": [
                135,
                405,
                853,
                455
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "global_block_id": 246,
            "global_group_id": 246,
            "block_polygon_points": [
                [
