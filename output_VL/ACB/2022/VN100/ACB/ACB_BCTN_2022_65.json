        },
        {
            "block_label": "text",
            "block_content": "Làm phát nhiều quốc gia cũng như toàn cầu lên cao và khá phổ biến, đạt mức định lịch sử nhiều chục năm, đến cuối năm 2022 hầu như đã qua mức cao nhất song vẫn tiếp tục vượt xa mục tiêu trong năm 2023 và chỉ có thể dịu bớt vào khoảng năm 2024 - 2025.",
            "block_bbox": [
                206,
                1292,
                1409,
                1426
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
