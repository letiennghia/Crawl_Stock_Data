        {
            "block_label": "text",
            "block_content": "Kinh tế Việt Nam đã vượt qua năm 2022 đấy khó khăn và thách thức, đạt được một số thành quả rất ấn tượng. 13/15 chi tiêu kế hoạch đầu năm đã được hoàn thành và hoàn thành vượt mức, nhất là tăng trưởng GDP đạt 8,02%, mức cao nhất kể từ năm 2012 và kiểm soát làm phát bình quân ở mức 3,15% so với mục tiêu 4%.",
            "block_bbox": [
                225,
                1196,
                1425,
                1368
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
