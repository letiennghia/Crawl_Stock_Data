        {
            "block_label": "text",
            "block_content": "- Thị trường chứng khoản nhìn chung đều phục hồi tích cực, thậm chí chứng khoản Mỹ tăng liên tiếp trong nhiều phiên cuối năm 2023.",
            "block_bbox": [
                251,
