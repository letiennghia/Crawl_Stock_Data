            ]
        },
        {
            "block_label": "text",
            "block_content": "Chính sách tiền tệ của Việt Nam năm 2023 mặc dù về nguyên tắc vấn chú trọng ổn định vĩ mô, kiểm soát lạm phát, nhưng đã nghiêng nhiều hơn đến hỗ trợ khó khăn cho doanh nghiệp và dân cư, thúc đẩy phục hồi tăng trưởng.",
            "block_bbox": [
                252,
                1020,
                1362,
                1153
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "global_block_id": 953,
            "global_group_id": 953,
            "block_polygon_points": [
                [
