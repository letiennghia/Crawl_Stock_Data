                ],
                [
                    266.0,
                    868.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1.1.1. Cuộc chiến chống lạm phát 2023 đã mang lại kết quả ấn tượng song chưa chắc chắn về khả năng kiểm soát lạm phát vững chắc ở mức mục tiêu, khiến các ngân hàng trung ương (NHTW) vấn thận trọng trong tiến trình nói lòng chính sách tiến tệ.",
            "block_bbox": [
                269,
                866,
                1376,
                1003
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "global_block_id": 921,
            "global_group_id": 921,
            "block_polygon_points": [
                [
                    269,
