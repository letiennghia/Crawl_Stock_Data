        {
            "block_label": "text",
            "block_content": "- Lượng phát thải GHG từ tiêu thụ điện năng trong năm 2023 có giảm nhẹ tương ứng ở mức 9% và 5% so với năm 2022 và năm 2021 do áp dụng các biện pháp tiết kiệm điện.",
            "block_bbox": [
                342,
                673,
                1367,
                759
            ],
            "block_id": 2,
            "block_order": 3,
