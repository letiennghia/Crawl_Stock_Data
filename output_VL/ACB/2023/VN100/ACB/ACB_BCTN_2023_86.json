    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "- So với năm 2022 và năm 2021, tổng lượng phát thải GHG năm 2023 giảm lẫn lượt là 11% và 3%. Lượng GHG giảm từ mức phát thải 34.335 tấn CO₂ trong năm 2022 và 31.685 tấn CO₂ trong năm 2022 xuống mức 30.708 tấn CO₂ trong năm 2023 do các nguồn phát thải từ điện, xăng và giấy đều giảm.",
            "block_bbox": [
                343,
                245,
                1366,
                413
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "global_block_id": 1136,
            "global_group_id": 1136,
            "block_polygon_points": [
                [
                    341.3211975097656,
