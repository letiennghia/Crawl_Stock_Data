                ],
                [
                    343.0000305175781,
                    412.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- Lượng phát thải GHG từ tiêu thụ điện năng chiếm phần lớn của tổng lượng phát thải, với tỷ lệ khoảng 86% và 26.451 tấn CO₂ trong năm 2023. Phát thải từ điện năng được ACB quy đổi theo hệ số phát thải của lưới điện Việt Nam năm 2021 trong Công văn số 1278 BĐKH-TTBVTOD của Cục Biến đổi khí hậu, Bộ Tài nguyên và Môi trường và cũng đang được xếp vào loại phát thải GHG gián tiếp từ năng lượng (Phạm vi 2) theo tiêu chuẩn của GR1.",
            "block_bbox": [
                342,
                418,
                1366,
                664
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "global_block_id": 1137,
