        {
            "block_label": "text",
            "block_content": "Ban kiểm toán nội bộ thực hiện kế hoạch kiểm toán theo định hướng rủi ro và toàn diện. Đối tượng kiểm toán là các chi nhánh/ phòng giao dịch có rủi ro và chưa được kiểm toán trong thời hạn ba năm; các quy trình nghiệp vụ, sản phẩm, đơn vị thuộc Hội sở có ảnh hưởng trọng yếu đến hoạt động Ngân hàng.",
            "block_bbox": [
                199,
                962,
                1459,
                1146
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "global_block_id": 874,
            "global_group_id": 874,
            "block_polygon_points": [
                [
                    199.0,
