        },
        {
            "block_label": "text",
            "block_content": "Kinh tế Mỹ cả năm tăng trưởng 2,8%, xấp xỉ mức 2023 (2,9%), lạm phát CPI tháng 12 là 2,9%; Khu vực đồng EURO tăng 0,8%, lạm phát CPI cuối năm ở mức 2,5%; Nhật tăng trưởng 0,3%, lạm phát CPI lỗi cuối năm tăng 2,7% so cùng kỳ; Trung Quốc tăng trưởng 4,8%, đến cuối 2024 vẫn trong tình trạng giảm phát; Các nền kinh tế mới nổi đang phát triển tăng trưởng khoảng 4,2%, lạm phát 7,9%; Riêng khu vực Đông Nam Á tăng trưởng khoảng 4,7%.",
            "block_bbox": [
                197,
                694,
                1458,
                931
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "global_block_id": 918,
            "global_group_id": 918,
            "block_polygon_points": [
