        {
            "block_label": "text",
            "block_content": "IMF đánh giá kinh tế toàn cầu 2024 tăng trưởng ổn định, đạt khoảng 3,2% so với 2023, tăng 0,1%. Suy thoái và đình lạm đã không diễn ra. Lạm phát giảm từ 5,9% năm 2023 xuống 5,4%.",
            "block_bbox": [
                197,
                587,
                1456,
                687
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "global_block_id": 917,
            "global_group_id": 917,
            "block_polygon_points": [
                [
                    196.230712890625,
                    598.0068359375
                ],
                [
